[Unit]
Description=Démon DMX512 via SPI (Art-Net local -> SPI0)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# Pas de --channels : le démon émet autant de canaux que le dernier paquet Art-Net reçu
# (le contrôleur envoie jusqu'au dernier canal utilisé par le plan de feu).
ExecStart=/usr/bin/python3 -m spi_dmx --universe 0 --rate 40 --bind 127.0.0.1
Restart=always
RestartSec=2
Nice=-10
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20

[Install]
WantedBy=multi-user.target
